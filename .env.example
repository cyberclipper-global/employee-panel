# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.
# Full explanation: docs/SECURITY.md and docs/CRM_SETUP.md

# Firebase service accounts (one-line JSON)
ADMIN_SERVICE_ACCOUNT=        # admin-panel-bae8d
EMPLOYEE_SERVICE_ACCOUNT=     # employee-panel-7a54c (new for this panel)
INTERN_SERVICE_ACCOUNT=

# Sign-in and sessions
SESSION_SECRET=               # 32+ random chars
AUTH_ENCRYPTION_KEY=          # same as admin panel
INTERNAL_API_SECRET=          # same as admin panel
LEGACY_VAULT_KEY=             # temporary: old vault key, remove after migration
NEXTAUTH_URL=                 # ADMIN panel public URL (internal calls)

# Email (verification codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_EMAIL=

# Leads / CRM
CRM_PHONE_ENCRYPTION_KEY=     # same as admin panel
CRM_DEFAULT_COUNTRY_CODE=91

# Plivo (server-side only; never prefix with NEXT_PUBLIC_)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_APPLICATION_ID=
PLIVO_CALLER_ID=
PLIVO_PHONE_NUMBER=
PLIVO_WEBHOOK_BASE_URL=
PLIVO_RING_TIMEOUT=45
