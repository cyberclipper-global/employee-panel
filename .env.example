# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# --- Existing variables (already used by the employee panel) ---
SESSION_SECRET=               # signs the employeeSession cookie
ADMIN_SERVICE_ACCOUNT=        # JSON of a service account for Firebase project admin-panel-bae8d (one line)

# --- New for Leads / CRM ---
# MUST be the same value as CRM_PHONE_ENCRYPTION_KEY in the admin panel.
CRM_PHONE_ENCRYPTION_KEY=
CRM_DEFAULT_COUNTRY_CODE=91

# --- Plivo (server-side only; never prefix with NEXT_PUBLIC_) ---
PLIVO_AUTH_ID=                # Plivo console → Overview/Account → Auth ID
PLIVO_AUTH_TOKEN=             # Plivo console → Overview/Account → Auth Token
PLIVO_APPLICATION_ID=         # Plivo console → Voice → Applications → your CRM app → App ID
PLIVO_CALLER_ID=              # Your Plivo voice number in E.164, e.g. +9180XXXXXXXX (shown to the customer)
PLIVO_PHONE_NUMBER=           # Optional: used as caller ID only if PLIVO_CALLER_ID is empty
PLIVO_WEBHOOK_BASE_URL=       # Public https URL of this employee panel, no trailing slash, e.g. https://employee.example.com
PLIVO_RING_TIMEOUT=45         # Optional: seconds to ring the customer (10-120)
